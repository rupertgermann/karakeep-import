{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rupertgermann/karakeep-import/release/acceptance-evidence.schema.json",
  "title": "Karakeep Transfer native release acceptance evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "target",
    "commit",
    "product",
    "testedAt",
    "checkout",
    "artifact",
    "signingIdentities",
    "platforms",
    "gates"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "target": {
      "enum": [
        "macos-universal",
        "windows-x64"
      ]
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "identifier",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "identifier": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "testedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "checkout": {
      "$ref": "#/$defs/passWithEvidence"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "size",
        "sha256"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._ -]{0,191}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "signingIdentities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/signingIdentity"
      }
    },
    "applicationPayload": {
      "$ref": "#/$defs/passWithEvidence"
    },
    "platforms": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 2,
      "maxProperties": 2,
      "properties": {
        "macos-arm64": {
          "$ref": "#/$defs/passWithEvidence"
        },
        "macos-x86_64-native": {
          "$ref": "#/$defs/passWithEvidence"
        },
        "windows-10-x64": {
          "$ref": "#/$defs/passWithEvidence"
        },
        "windows-11-x64": {
          "$ref": "#/$defs/passWithEvidence"
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "native baseline",
        "clean install",
        "no system runtime",
        "five-browser matrix",
        "X transfer",
        "File transfer",
        "signature",
        "platform verification"
      ],
      "properties": {
        "native baseline": {
          "$ref": "#/$defs/passWithEvidence"
        },
        "clean install": {
          "$ref": "#/$defs/passWithEvidence"
        },
        "no system runtime": {
          "$ref": "#/$defs/passWithEvidence"
        },
        "five-browser matrix": {
          "$ref": "#/$defs/passWithEvidence"
        },
        "X transfer": {
          "$ref": "#/$defs/passWithEvidence"
        },
        "File transfer": {
          "$ref": "#/$defs/passWithEvidence"
        },
        "signature": {
          "$ref": "#/$defs/passWithEvidence"
        },
        "platform verification": {
          "$ref": "#/$defs/passWithEvidence"
        }
      }
    }
  },
  "$defs": {
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "sha256",
        "assertionId",
        "platform"
      ],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,122}\\.json$",
          "not": {
            "pattern": "^[Aa][Cc][Cc][Ee][Pp][Tt][Aa][Nn][Cc][Ee]-[Ee][Vv][Ii][Dd][Ee][Nn][Cc][Ee]\\.[Jj][Ss][Oo][Nn]$"
          }
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "assertionId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9:_-]{2,127}$"
        },
        "platform": {
          "enum": [
            "target-wide",
            "macos-arm64",
            "macos-x86_64-native",
            "windows-10-x64",
            "windows-11-x64"
          ]
        }
      }
    },
    "signingIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "assertionId",
        "subject",
        "stableIdentifier",
        "certificateSha256",
        "timestampStatus",
        "evidence"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
        },
        "assertionId": {
          "type": "string",
          "pattern": "^signing-identity:[a-z0-9][a-z0-9-]{1,63}$"
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "stableIdentifier": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
        },
        "certificateSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "timestampStatus": {
          "const": "PASS"
        },
        "evidence": {
          "$ref": "#/$defs/evidenceReferences"
        }
      }
    },
    "evidenceReferences": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/evidenceReference"
      }
    },
    "passWithEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidence"
      ],
      "properties": {
        "status": {
          "const": "PASS"
        },
        "evidence": {
          "$ref": "#/$defs/evidenceReferences"
        }
      }
    },
    "typedEvidenceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "target",
        "commit",
        "artifact",
        "assertionId",
        "platform",
        "tool",
        "checkType",
        "status",
        "resultSummary"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "target": {
          "enum": [
            "macos-universal",
            "windows-x64"
          ]
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "filename",
            "size",
            "sha256"
          ],
          "properties": {
            "filename": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._ -]{0,191}$"
            },
            "size": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "assertionId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9:_-]{2,127}$"
        },
        "platform": {
          "enum": [
            "target-wide",
            "macos-arm64",
            "macos-x86_64-native",
            "windows-10-x64",
            "windows-11-x64"
          ]
        },
        "tool": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{1,63}$"
        },
        "checkType": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
        },
        "status": {
          "const": "PASS"
        },
        "resultSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\r\\n]+$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "target": {
            "const": "macos-universal"
          }
        },
        "required": [
          "target"
        ]
      },
      "then": {
        "not": {
          "required": [
            "applicationPayload"
          ]
        },
        "properties": {
          "platforms": {
            "required": [
              "macos-arm64",
              "macos-x86_64-native"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "target": {
            "const": "windows-x64"
          }
        },
        "required": [
          "target"
        ]
      },
      "then": {
        "required": [
          "applicationPayload"
        ],
        "properties": {
          "platforms": {
            "required": [
              "windows-10-x64",
              "windows-11-x64"
            ]
          }
        }
      }
    }
  ]
}
